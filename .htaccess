# Hundepension im Park – Apache-Konfiguration (nur nötig bei Apache-Hosting)
Options -Indexes
AddDefaultCharset UTF-8
DirectorySlash On
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Arbeitsordner, Git-Daten und Dokumentation nicht ausliefern
  RewriteRule ^(_original|tools|deploy|\.git)(/|$) - [F,L]
  RewriteRule ^\.git - [F,L]
  RewriteRule ^[^/]+\.md$ - [F,L]
  RewriteRule ^api/config(\.local)?\.php$ - [F,L]
  # Alte Jimdo-Adressen
  RewriteRule ^app/download/17046496824/ /assets/docs/Anmeldeformular_im_Park.pdf [R=301,L]
  RewriteRule ^j/privacy$ /j/privacy/ [R=301,L]
  RewriteRule ^j/cookies/policy/?$ /j/privacy/ [R=301,L]
  RewriteRule ^sitemap/?$ /sitemap.xml [R=301,L]
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  <FilesMatch "\.(webp|png|jpg|ico|woff2|pdf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml application/manifest+json
</IfModule>
